{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_sermon-prep_desk__delete_sermon$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-delete-sermon.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_sermon-prep_desk__save_draft$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/draft-receipt.sh\""
          }
        ]
      }
    ]
  }
}
